{
  "name": "@handsforbots/consent",
  "version": "2.0.0-alpha.4",
  "description": "Add-on. Consent rule sets for Hands for Bots (LGPD, GDPR, CCPA starting points), JSON/YAML loaders, region helpers and anonymization.",
  "keywords": [
    "handsforbots",
    "h4b",
    "h4b-addon"
  ],
  "license": "MIT",
  "homepage": "https://github.com/handsforbots/handsforbots/blob/main/docs/en-us/plugins.md#consent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handsforbots/handsforbots.git",
    "directory": "packages/consent"
  },
  "bugs": {
    "url": "https://github.com/handsforbots/handsforbots/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./rules/*": "./rules/*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./rules/*": "./rules/*"
    }
  },
  "files": [
    "dist",
    "rules"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^"
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^",
    "@handsforbots/storage-local": "workspace:^",
    "@handsforbots/testkit": "workspace:^",
    "jsdom": "^31.0.1"
  }
}
