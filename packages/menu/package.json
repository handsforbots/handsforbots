{
  "name": "@handsforbots/menu",
  "version": "2.0.0-alpha.0",
  "description": "Direct commands (no LLM) for Hands for Bots: slash, patterns and fuzzy phrases.",
  "license": "MIT",
  "homepage": "https://github.com/handsforbots/handsforbots/blob/main/docs/en-us/plugins.md#menu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handsforbots/handsforbots.git",
    "directory": "packages/menu"
  },
  "bugs": {
    "url": "https://github.com/handsforbots/handsforbots/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^"
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^"
  }
}
