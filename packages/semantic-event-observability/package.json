{
  "name": "@handsforbots/semantic-event-observability",
  "version": "0.1.2",
  "description": "Standalone. Semantic observability for async event systems — logs, metrics, and tracing with optional Grafana, Langfuse, and LangSmith exporters.",
  "keywords": [
    "handsforbots",
    "h4b",
    "h4b-standalone",
    "observability",
    "events",
    "async",
    "opentelemetry",
    "grafana",
    "faro",
    "langfuse",
    "langsmith",
    "event-bus"
  ],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./packageIdentity": "./packageIdentity.js",
    "./adapters/genericEventBus": "./adapters/genericEventBus.js",
    "./baggage": {
      "types": "./core/baggage.d.ts",
      "import": "./core/baggage.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "packageIdentity.js",
    "core/",
    "adapters/",
    "exporters/",
    "utils/",
    "grafana/",
    "docs/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "homepage": "https://github.com/handsforbots/handsforbots/tree/main/packages/semantic-event-observability#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handsforbots/handsforbots.git",
    "directory": "packages/semantic-event-observability"
  },
  "bugs": {
    "url": "https://github.com/handsforbots/handsforbots/issues"
  },
  "peerDependencies": {
    "@grafana/faro-web-sdk": ">=1.0.0",
    "@langfuse/tracing": ">=4.0.0",
    "@opentelemetry/api": ">=1.0.0",
    "langsmith": ">=0.3.0",
    "web-vitals": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@grafana/faro-web-sdk": {
      "optional": true
    },
    "@langfuse/tracing": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "langsmith": {
      "optional": true
    },
    "web-vitals": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
