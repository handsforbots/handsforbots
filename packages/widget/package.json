{
  "name": "@handsforbots/widget",
  "version": "2.0.0-alpha.2",
  "description": "UI. Ready-made conversation surface for Hands for Bots as a Web Component (<h4b-chat>): works in plain HTML, React, Vue…",
  "keywords": [
    "handsforbots",
    "h4b",
    "h4b-ui"
  ],
  "license": "MIT",
  "homepage": "https://github.com/handsforbots/handsforbots/blob/main/docs/en-us/plugins.md#widget",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handsforbots/handsforbots.git",
    "directory": "packages/widget"
  },
  "bugs": {
    "url": "https://github.com/handsforbots/handsforbots/issues"
  },
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": "./src/index.ts",
    "./focus": "./src/focus.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./focus": {
        "types": "./dist/focus.d.ts",
        "import": "./dist/focus.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^"
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^",
    "@handsforbots/cues": "workspace:^",
    "@handsforbots/menu": "workspace:^",
    "@handsforbots/voice": "workspace:^",
    "fast-check": "^4.10.2",
    "jsdom": "^27.0.0"
  },
  "peerDependenciesMeta": {}
}
