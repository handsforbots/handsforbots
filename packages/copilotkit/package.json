{
  "name": "@handsforbots/copilotkit",
  "version": "2.0.0-alpha.2",
  "description": "UI. CopilotKit bridge for Hands for Bots: actions as frontend tools, context, and voice/menu/sensor input through the CopilotKit agent.",
  "keywords": [
    "handsforbots",
    "h4b",
    "h4b-ui"
  ],
  "license": "MIT",
  "homepage": "https://github.com/handsforbots/handsforbots/blob/main/docs/en-us/plugins.md#copilotkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handsforbots/handsforbots.git",
    "directory": "packages/copilotkit"
  },
  "bugs": {
    "url": "https://github.com/handsforbots/handsforbots/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.tsx"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@copilotkit/react-core": ">=1.77",
    "@handsforbots/core": "workspace:^",
    "@handsforbots/react": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@copilotkit/react-core": "^1.87.1",
    "@handsforbots/core": "workspace:^",
    "@handsforbots/react": "workspace:^",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "jsdom": "^27.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "7.8.2"
  },
  "dependencies": {
    "@handsforbots/transport-agui": "workspace:^"
  }
}
