{
  "name": "@handsforbots/guided",
  "version": "2.0.0-alpha.2",
  "description": "Plugin. Guided tours and on-screen highlights that assistants, agents and users can trigger (successor of v1 GUIDed).",
  "keywords": [
    "handsforbots",
    "h4b",
    "h4b-plugin"
  ],
  "license": "MIT",
  "homepage": "https://github.com/handsforbots/handsforbots/blob/main/docs/en-us/plugins.md#guided",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handsforbots/handsforbots.git",
    "directory": "packages/guided"
  },
  "bugs": {
    "url": "https://github.com/handsforbots/handsforbots/issues"
  },
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^"
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^",
    "jsdom": "^27.0.0"
  },
  "dependencies": {
    "@handsforbots/menu": "workspace:^"
  }
}
