{
  "name": "@handsforbots/vue",
  "version": "2.0.0-alpha.5",
  "description": "UI. Vue bindings for Hands for Bots: plugin and composables for messages, actions, context and stimuli.",
  "keywords": [
    "handsforbots",
    "h4b",
    "h4b-ui"
  ],
  "license": "MIT",
  "homepage": "https://github.com/handsforbots/handsforbots/blob/main/docs/en-us/plugins.md#vue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handsforbots/handsforbots.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/handsforbots/handsforbots/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^",
    "vue": ">=3.3"
  },
  "dependencies": {
    "@handsforbots/widget": "workspace:^"
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^",
    "@handsforbots/voice": "workspace:^",
    "jsdom": "^31.0.1",
    "vue": "^3.5.45"
  }
}
