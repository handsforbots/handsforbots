{
  "name": "@handsforbots/assistant-ui",
  "version": "2.0.0-alpha.3",
  "description": "UI. assistant-ui runtime for Hands for Bots: use assistant-ui components as the conversation surface over any H4B transport.",
  "keywords": [
    "handsforbots",
    "h4b",
    "h4b-ui"
  ],
  "license": "MIT",
  "homepage": "https://github.com/handsforbots/handsforbots/blob/main/docs/en-us/plugins.md#assistant-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handsforbots/handsforbots.git",
    "directory": "packages/assistant-ui"
  },
  "bugs": {
    "url": "https://github.com/handsforbots/handsforbots/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.tsx"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@assistant-ui/react": ">=0.15",
    "@handsforbots/core": "workspace:^",
    "@handsforbots/react": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.15.36",
    "@handsforbots/core": "workspace:^",
    "@handsforbots/react": "workspace:^",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
