{
  "name": "@handsforbots/testkit",
  "version": "2.0.0-alpha.5",
  "description": "Dev. Test helpers and a transport conformance suite for Hands for Bots apps and plugins.",
  "keywords": [
    "handsforbots",
    "h4b",
    "h4b-dev"
  ],
  "license": "MIT",
  "homepage": "https://github.com/handsforbots/handsforbots/blob/main/docs/en-us/plugins.md#testkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handsforbots/handsforbots.git",
    "directory": "packages/testkit"
  },
  "bugs": {
    "url": "https://github.com/handsforbots/handsforbots/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^",
    "vitest": ">=3"
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^",
    "vitest": "^5.1.0"
  }
}
