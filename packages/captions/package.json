{
  "name": "@handsforbots/captions",
  "version": "2.0.0-alpha.4",
  "description": "Plugin. Word-by-word captions and reading cadence for Hands for Bots: follows voice timings or drives text on its own, with a ready-made renderer and custom element.",
  "keywords": [
    "handsforbots",
    "h4b",
    "h4b-plugin"
  ],
  "license": "MIT",
  "homepage": "https://github.com/handsforbots/handsforbots/blob/main/docs/en-us/plugins.md#captions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handsforbots/handsforbots.git",
    "directory": "packages/captions"
  },
  "bugs": {
    "url": "https://github.com/handsforbots/handsforbots/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./cadence": "./src/cadence.ts",
    "./element": "./src/element.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./cadence": {
        "types": "./dist/cadence.d.ts",
        "import": "./dist/cadence.js"
      },
      "./element": {
        "types": "./dist/element.d.ts",
        "import": "./dist/element.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^",
    "@handsforbots/voice": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@handsforbots/voice": {
      "optional": true
    }
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^",
    "@handsforbots/voice": "workspace:^",
    "@handsforbots/widget": "workspace:^",
    "jsdom": "^31.0.1"
  }
}
