{
  "name": "@handsforbots/cues",
  "version": "2.0.0-alpha.0",
  "description": "Cues for Hands for Bots: closed-vocabulary presentation categories (tone, scene, urgency…) set by the backend, an action or content rules, with repetition counts and policies.",
  "license": "MIT",
  "homepage": "https://github.com/handsforbots/handsforbots/blob/main/docs/en-us/plugins.md#cues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handsforbots/handsforbots.git",
    "directory": "packages/cues"
  },
  "bugs": {
    "url": "https://github.com/handsforbots/handsforbots/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^"
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^",
    "@handsforbots/testkit": "workspace:^",
    "@handsforbots/voice": "workspace:^",
    "@handsforbots/transport-agui": "workspace:^",
    "@handsforbots/transport-http": "workspace:^"
  }
}
