{
  "name": "@handsforbots/react",
  "version": "2.0.0-alpha.2",
  "description": "UI. React bindings for Hands for Bots: provider and hooks for messages, actions, context and stimuli.",
  "keywords": [
    "handsforbots",
    "h4b",
    "h4b-ui"
  ],
  "license": "MIT",
  "homepage": "https://github.com/handsforbots/handsforbots/blob/main/docs/en-us/plugins.md#react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handsforbots/handsforbots.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/handsforbots/handsforbots/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.tsx"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@handsforbots/core": "workspace:^",
    "react": ">=18"
  },
  "dependencies": {
    "@handsforbots/widget": "workspace:^"
  },
  "devDependencies": {
    "@handsforbots/core": "workspace:^",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
