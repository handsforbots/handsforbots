#!/bin/sh
# Blocks commits that add secrets (API keys, tokens, private keys).
# Enabled by `pnpm install` (the root `prepare` script sets core.hooksPath).
# A false positive: add its fingerprint to .gitleaksignore with a comment.

if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks git --pre-commit --staged --redact --no-banner
fi

if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  exec docker run --rm -v "$(pwd):/repo" -w /repo ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f \
    git --pre-commit --staged --redact --no-banner
fi

echo "pre-commit: Gitleaks is not installed, so staged changes were not scanned for secrets." >&2
echo "Install it (brew install gitleaks, or see https://github.com/gitleaks/gitleaks#installing)" >&2
echo "or start Docker, then commit again." >&2
exit 1
