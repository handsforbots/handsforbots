{
  "name": "handsforbots-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter '@handsforbots/*' --filter '!@handsforbots/example-*' build",
    "test": "vitest run && pnpm --filter @handsforbots/semantic-event-observability test",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter '@handsforbots/*' typecheck",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "1.65.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.5"
  }
}
